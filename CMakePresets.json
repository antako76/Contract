{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default (Clang 22)",
      "description": "Configure CONTRACT with Clang 22.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-clang22",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang++-22",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "gcc13",
      "displayName": "GCC 13",
      "description": "Configure CONTRACT with GCC 13.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "c++",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "jobs": 0
    },
    {
      "name": "gcc13",
      "configurePreset": "gcc13",
      "jobs": 0
    }
  ]
}
